# Conexiunea la PostgreSQL (Supabase: „Transaction pooler” pentru DATABASE_URL, „Direct connection” pentru DIRECT_URL)
DATABASE_URL="postgresql://USER:PAROLA@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PAROLA@HOST:5432/postgres"

# Auth.js: generează cu `npx auth secret` sau `openssl rand -base64 32`
AUTH_SECRET=""
# Pe Vercel nu e nevoie; local: http://localhost:3000
AUTH_URL="http://localhost:3000"

# Primul utilizator ADMIN, creat de `npm run db:seed`
SEED_ADMIN_EMAIL="vladimir@twopixeldev.ro"
SEED_ADMIN_NAME="Vladimir"
SEED_ADMIN_PASSWORD=""
