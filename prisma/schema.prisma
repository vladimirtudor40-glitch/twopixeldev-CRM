// =============================================================================
// twopixeldev CRM — schema bazei de date (Pasul 1)
// PostgreSQL (Supabase / Neon) + Prisma 6
//
// Convenții:
//  - Numele modelelor și câmpurilor sunt în engleză (ca în platforma de
//    rezervări, ca să le putem lega), valorile enum-urilor sunt în română,
//    pentru că apar direct în interfață și în exporturi.
//  - Sumele de bani: Decimal(12,2), în lei (RON).
//  - Căutarea fără diacritice: coloanele *Normalized și `searchText` sunt
//    scrise de aplicație (lowercase, fără diacritice, fără spații duble).
//    Indexurile GIN cu pg_trgm permit căutare „fuzzy” rapidă pe ele;
//    extensia `unaccent` e folosită în interogările raw pentru textul introdus.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm, unaccent]
}

// -----------------------------------------------------------------------------
// Enum-uri
// -----------------------------------------------------------------------------

enum Role {
  ADMIN
  AGENT_VANZARI
}

enum PropertyType {
  HOTEL
  PENSIUNE_VILA
  APARTAMENT_REGIM_HOTELIER
  HOSTEL
  MOTEL
  CASA_DE_VACANTA
  CAMPING
  ALTUL
}

enum Zone {
  CONSTANTA
  MAMAIA
  MAMAIA_NORD_NAVODARI
  EFORIE_NORD
  EFORIE_SUD
  AGIGEA
  ALTA
}

enum WebsiteStatus {
  ARE_SITE_PROPRIU
  DOAR_PLATFORME // doar Booking / Facebook / alte platforme
  FARA_SITE
  NECUNOSCUT
}

enum Priority {
  A
  B
  C
}

enum PipelineStage {
  NOU
  DE_VERIFICAT
  CONTACTAT
  INTERESAT
  DEMO_PROGRAMAT
  OFERTA_TRIMISA
  NEGOCIERE
  CASTIGAT
  PIERDUT
  REVINO_MAI_TARZIU
}

enum LostReason {
  ARE_DEJA_SITE
  NU_VREA
  PRET
  NU_RASPUNDE
  INCHIS
  ALTUL
}

enum LeadSource {
  OSM
  MINISTER
  OSM_SI_MINISTER
  GOOGLE_MAPS
  GOOGLE_PLACES
  BOOKING
  FACEBOOK_INSTAGRAM
  PLATFORMA_LOCALA // Travelminit, Turistinfo, Infoturism
  RECOMANDARE
  TEREN
  MANUAL
}

enum ContactRole {
  PROPRIETAR
  ADMINISTRATOR
  MANAGER
  RECEPTIE
  CONTABIL
  ALTUL
}

enum ContactChannel {
  TELEFON
  WHATSAPP
  EMAIL
  VIZITA
}

enum InteractionType {
  APEL
  WHATSAPP
  EMAIL
  VIZITA
  DEMO
  NOTA
}

enum InteractionDirection {
  IESIRE // noi i-am contactat
  INTRARE // ne-au contactat ei
}

enum InteractionOutcome {
  FARA_RASPUNS
  NUMAR_GRESIT
  DISCUTIE_POZITIVA
  DISCUTIE_NEUTRA
  CERE_REVENIRE
  CERE_OFERTA
  DEMO_STABILIT
  REFUZ
  ALTUL
}

enum TaskType {
  APEL
  WHATSAPP
  EMAIL
  VIZITA
  DEMO
  TRIMITE_OFERTA
  VERIFICARE
  ALTUL
}

enum TaskStatus {
  DESCHISA
  FINALIZATA
  ANULATA
}

enum TaskPriority {
  NORMALA
  RIDICATA
}

enum OfferStatus {
  CIORNA
  TRIMISA
  ACCEPTATA
  RESPINSA
  EXPIRATA
}

enum ClientStatus {
  IN_IMPLEMENTARE
  ACTIV
  SUSPENDAT
  REZILIAT
}

enum ImplementationStatus {
  NEINCEPUT
  IN_LUCRU
  GATA
  NU_SE_APLICA
}

enum SubscriptionStatus {
  ACTIV
  IN_PAUZA
  ANULAT
}

enum PaymentKind {
  SETUP
  ABONAMENT
  ALTUL
}

enum PaymentStatus {
  NEPLATIT
  PARTIAL
  PLATIT
  ANULAT
}

enum PaymentMethod {
  TRANSFER_BANCAR
  CARD
  NUMERAR
  ALTA
}

enum ImportStatus {
  PREVIZUALIZARE // fișier încărcat, mapare + previzualizare, nimic scris încă
  IN_CURS
  FINALIZAT
  ESUAT
  ANULAT
}

enum ImportRowAction {
  CREAT
  ACTUALIZAT // doar câmpurile goale au fost completate
  NESCHIMBAT // duplicat, nimic nou de completat
  IGNORAT
  EROARE
}

enum AuditAction {
  CREARE
  ACTUALIZARE
  STERGERE
  RESTAURARE
  SCHIMBARE_ETAPA
  IMPORT
  EXPORT
  OPT_OUT
  LOGIN
}

// -----------------------------------------------------------------------------
// Utilizatori și autentificare (Auth.js / NextAuth v5 + @auth/prisma-adapter)
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // pentru login cu email + parolă (Credentials)
  role          Role      @default(AGENT_VANZARI)
  phone         String?
  active        Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  ownedLeads         Lead[]                @relation("LeadOwner")
  createdLeads       Lead[]                @relation("LeadCreatedBy")
  interactions       Interaction[]
  assignedTasks      Task[]                @relation("TaskAssignee")
  createdTasks       Task[]                @relation("TaskCreatedBy")
  stageChanges       PipelineStageChange[]
  offers             Offer[]
  accountManagerOf   Client[]
  recordedPayments   Payment[]
  importBatches      ImportBatch[]
  savedViews         SavedView[]
  auditLogs          AuditLog[]
  createdTemplates   OfferTemplate[]
  doNotContactMarked Lead[]                @relation("LeadDoNotContactBy")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// -----------------------------------------------------------------------------
// Lead = unitate de cazare (Property)
// -----------------------------------------------------------------------------

model Lead {
  id String @id @default(cuid())

  // Identificare
  name           String
  nameNormalized String // fără diacritice, lowercase, fără prefixe tip „pensiunea”, „vila”
  type           PropertyType @default(PENSIUNE_VILA)
  zone           Zone
  address        String?
  latitude       Decimal?     @db.Decimal(9, 6)
  longitude      Decimal?     @db.Decimal(9, 6)

  // Contact principal al unității (persoanele sunt în Contact)
  phone           String?
  phoneNormalized String? // doar cifre, format 07xxxxxxxx / 02xxxxxxxx
  email           String?

  // Clasificare și capacitate
  starsOsm         Int? // stele din OpenStreetMap
  categoryMinistry String? // ex. „3 stele”, „2 flori”, din lista ministerului
  roomsCount       Int?
  placesCount      Int?

  // Prezență online
  websiteStatus WebsiteStatus @default(NECUNOSCUT)
  websiteUrl    String?
  bookingUrl    String?
  facebookUrl   String?
  instagramUrl  String?
  otherLinks    String[] // Travelminit, Turistinfo etc.
  googleMapsUrl String?
  osmUrl        String?
  osmId         String?       @unique
  ratingGoogle  Decimal?      @db.Decimal(2, 1) // completat manual, 1.0–5.0
  ratingBooking Decimal?      @db.Decimal(3, 1) // completat manual, 1.0–10.0

  // Operator (firma care exploatează unitatea)
  operatorName     String?
  operatorCui      String?
  inMinistryList   Boolean @default(false)
  ministryRecordId String? // nr. certificat / ID din lista ministerului

  // Vânzări
  source                 LeadSource    @default(MANUAL)
  priority               Priority      @default(B)
  stage                  PipelineStage @default(NOU)
  stageChangedAt         DateTime      @default(now())
  stageOrder             Int           @default(0) // ordinea cardului în coloana Kanban
  lostReason             LostReason?
  lostReasonNote         String?
  followUpAt             DateTime? // pentru REVINO_MAI_TARZIU
  manualCheckNote        String? // „Verificare manuală” din exportul scriptului
  notes                  String?
  estimatedAnnualRevenue Decimal?      @db.Decimal(12, 2) // pentru calculatorul de economii
  lastInteractionAt      DateTime?
  nextTaskAt             DateTime? // denormalizat: cea mai apropiată sarcină deschisă

  // Responsabil
  ownerId     String?
  owner       User?   @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?   @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Opt-out „Nu mai contacta” (prospectare B2B, GDPR)
  doNotContact       Boolean   @default(false)
  doNotContactAt     DateTime?
  doNotContactReason String?
  doNotContactById   String?
  doNotContactBy     User?     @relation("LeadDoNotContactBy", fields: [doNotContactById], references: [id], onDelete: SetNull)

  // Căutare și deduplicare
  searchText String  @default("") // nume + adresă + telefon + email + operator, normalizate
  dedupeKey  String? // nameNormalized|zone|phoneNormalized

  // Proveniența importului
  firstImportBatchId String?
  firstImportBatch   ImportBatch? @relation("LeadFirstImport", fields: [firstImportBatchId], references: [id], onDelete: SetNull)

  archivedAt DateTime? // ștergere logică
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  contacts     Contact[]
  interactions Interaction[]
  tasks        Task[]
  stageChanges PipelineStageChange[]
  offers       Offer[]
  client       Client?
  tags         LeadTag[]
  importRows   ImportRow[]

  @@index([zone, priority])
  @@index([stage, stageOrder])
  @@index([ownerId, stage])
  @@index([websiteStatus])
  @@index([lastInteractionAt])
  @@index([nameNormalized, zone])
  @@index([phoneNormalized])
  @@index([dedupeKey])
  @@index([operatorCui])
  @@index([archivedAt])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Lead_searchText_trgm_idx")
  @@index([nameNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "Lead_nameNormalized_trgm_idx")
}

model Contact {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  name             String
  role             ContactRole    @default(PROPRIETAR)
  phone            String?
  phoneNormalized  String?
  whatsapp         String? // dacă diferă de telefon
  email            String?
  preferredChannel ContactChannel @default(TELEFON)
  isPrimary        Boolean        @default(false)
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  interactions Interaction[]
  tasks        Task[]

  @@index([leadId])
  @@index([phoneNormalized])
}

model Interaction {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  type            InteractionType
  direction       InteractionDirection @default(IESIRE)
  outcome         InteractionOutcome?
  occurredAt      DateTime             @default(now())
  durationMinutes Int?
  summary         String? // o linie, apare în listă
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  createdTasks Task[] @relation("TaskFromInteraction")

  @@index([leadId, occurredAt(sort: Desc)])
  @@index([userId, occurredAt])
  @@index([type, occurredAt])
}

model Task {
  id        String   @id @default(cuid())
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  title       String // „Sună din nou marți”, „Trimite oferta”
  description String?
  type        TaskType     @default(APEL)
  priority    TaskPriority @default(NORMALA)
  status      TaskStatus   @default(DESCHISA)
  dueAt       DateTime
  hasTime     Boolean      @default(false) // false = doar ziua contează
  remindAt    DateTime?
  completedAt DateTime?

  assigneeId    String?
  assignee      User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?        @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  interactionId String? // sarcina creată din rezultatul unei interacțiuni
  interaction   Interaction? @relation("TaskFromInteraction", fields: [interactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId, status, dueAt])
  @@index([leadId, status])
  @@index([status, dueAt])
}

model PipelineStageChange {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  fromStage  PipelineStage?
  toStage    PipelineStage
  lostReason LostReason?
  followUpAt DateTime?
  note       String?
  changedAt  DateTime       @default(now())

  changedById String?
  changedBy   User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([leadId, changedAt])
  @@index([toStage, changedAt])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#178582")
  createdAt DateTime @default(now())

  leads LeadTag[]
}

model LeadTag {
  leadId    String
  tagId     String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([tagId])
}

model SavedView {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isShared  Boolean  @default(false) // vizibilă pentru toată echipa
  // { q, zones[], types[], priorities[], websiteStatuses[], stages[], hasPhone,
  //   lastInteractionBefore, ownerId, tagIds[] }
  filters   Json
  // { column, direction }[] + coloane vizibile
  sort      Json?
  columns   String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

// -----------------------------------------------------------------------------
// Oferte
// -----------------------------------------------------------------------------

model OfferTemplate {
  id               String   @id @default(cuid())
  name             String // „Esențial”, „Standard”, „Premium”
  description      String?
  setupPrice       Decimal  @db.Decimal(12, 2)
  monthlyFee       Decimal  @db.Decimal(12, 2)
  includedFeatures String[]
  introText        String? // text de început al ofertei
  termsText        String? // condiții, valabilitate, plată
  validityDays     Int      @default(30)
  isDefault        Boolean  @default(false)
  active           Boolean  @default(true)
  createdById      String?
  createdBy        User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  offers Offer[]
}

model Offer {
  id         String         @id @default(cuid())
  number     String         @unique // ex. „TPD-2026-0012”
  leadId     String
  lead       Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  templateId String?
  template   OfferTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  status      OfferStatus @default(CIORNA)
  planName    String
  setupPrice  Decimal     @db.Decimal(12, 2)
  monthlyFee  Decimal     @db.Decimal(12, 2)
  discountPct Decimal?    @db.Decimal(5, 2)
  features    String[]
  customText  String?
  validUntil  DateTime?

  // Calculator de economii (date de intrare)
  annualRevenue        Decimal  @db.Decimal(12, 2) // încasări anuale estimate
  bookingCommissionPct Decimal  @default(15) @db.Decimal(5, 2) // 15–18%
  bookingSharePct      Decimal  @default(70) @db.Decimal(5, 2) // cât din încasări vin azi prin Booking
  directSharePct       Decimal  @default(25) @db.Decimal(5, 2) // cât din rezervările Booking mutăm pe direct
  // Rezultate calculate la salvare (rămân fixe pe ofertă)
  commissionSavedYear  Decimal  @db.Decimal(12, 2)
  ourCostYear1         Decimal  @db.Decimal(12, 2) // setup + 12 × abonament
  ourCostYearN         Decimal  @db.Decimal(12, 2) // 12 × abonament
  netBenefitYear1      Decimal  @db.Decimal(12, 2)
  paybackMonths        Decimal? @db.Decimal(5, 1)

  pdfUrl      String?
  sentAt      DateTime?
  respondedAt DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client Client?

  @@index([leadId, createdAt])
  @@index([status])
}

// -----------------------------------------------------------------------------
// Clienți, abonamente, încasări
// -----------------------------------------------------------------------------

model Client {
  id      String  @id @default(cuid())
  leadId  String  @unique
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Restrict)
  offerId String? @unique // oferta acceptată
  offer   Offer?  @relation(fields: [offerId], references: [id], onDelete: SetNull)

  status     ClientStatus @default(IN_IMPLEMENTARE)
  planName   String
  setupPrice Decimal      @db.Decimal(12, 2)
  monthlyFee Decimal      @db.Decimal(12, 2)
  startDate  DateTime
  domain     String? // numepensiune.ro
  tenantSlug String?      @unique // legătura cu Tenant din platforma de rezervări

  // Date de facturare
  billingName    String?
  billingCui     String?
  billingRegCom  String?
  billingAddress String?
  billingEmail   String?
  vatPayer       Boolean?

  // Status implementare
  siteStatus          ImplementationStatus @default(NEINCEPUT)
  bookingEngineStatus ImplementationStatus @default(NEINCEPUT)
  icalStatus          ImplementationStatus @default(NEINCEPUT)
  paymentsStatus      ImplementationStatus @default(NEINCEPUT)
  goLiveAt            DateTime?

  accountManagerId String?
  accountManager   User?    @relation(fields: [accountManagerId], references: [id], onDelete: SetNull)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]

  @@index([status])
}

model Subscription {
  id         String             @id @default(cuid())
  clientId   String
  client     Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  planName   String
  monthlyFee Decimal            @db.Decimal(12, 2)
  billingDay Int                @default(1) // ziua din lună la care se emite factura
  startDate  DateTime
  endDate    DateTime?
  status     SubscriptionStatus @default(ACTIV)
  notes      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  payments Payment[]

  @@index([clientId, status])
}

model Payment {
  id             String        @id @default(cuid())
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  kind          PaymentKind    @default(ABONAMENT)
  periodMonth   DateTime?      @db.Date // prima zi a lunii acoperite (abonament)
  amount        Decimal        @db.Decimal(12, 2)
  amountPaid    Decimal        @default(0) @db.Decimal(12, 2)
  dueDate       DateTime       @db.Date
  paidAt        DateTime?
  status        PaymentStatus  @default(NEPLATIT)
  method        PaymentMethod?
  invoiceNumber String?
  notes         String?
  recordedById  String?
  recordedBy    User?          @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([subscriptionId, periodMonth])
  @@index([status, dueDate])
  @@index([clientId, dueDate])
}

// -----------------------------------------------------------------------------
// Import Excel / CSV
// -----------------------------------------------------------------------------

model ImportBatch {
  id             String       @id @default(cuid())
  fileName       String
  sheetName      String? // „Leaduri”
  status         ImportStatus @default(PREVIZUALIZARE)
  // coloana din fișier -> câmpul din Lead, ex. { "Nume": "name", "Zona": "zone" }
  columnMap      Json
  totalRows      Int          @default(0)
  createdRows    Int          @default(0)
  updatedRows    Int          @default(0)
  unchangedRows  Int          @default(0)
  skippedRows    Int          @default(0)
  errorRows      Int          @default(0)
  defaultOwnerId String? // responsabil atribuit lead-urilor noi
  startedAt      DateTime?
  finishedAt     DateTime?
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  rows       ImportRow[]
  firstLeads Lead[]      @relation("LeadFirstImport")

  @@index([createdAt])
}

model ImportRow {
  id            String           @id @default(cuid())
  batchId       String
  batch         ImportBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber     Int
  raw           Json // rândul original, așa cum a venit din fișier
  action        ImportRowAction?
  leadId        String?
  lead          Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  matchedBy     String? // „osmId”, „nume+zonă+telefon”, „nume+zonă”, „telefon”
  updatedFields String[] // câmpurile goale completate la re-import
  error         String?

  @@unique([batchId, rowNumber])
  @@index([leadId])
}

// -----------------------------------------------------------------------------
// Audit
// -----------------------------------------------------------------------------

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String // „Lead”, „Contact”, „Offer”, „Client”, „Payment” ...
  entityId   String?
  // { câmp: { from, to } } pentru actualizări
  changes    Json?
  meta       Json? // ip, user agent, id import etc.
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}
