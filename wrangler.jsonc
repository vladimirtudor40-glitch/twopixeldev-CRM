{
  // Versiunea web a CRM-ului (inclusă în site la twopixeldev.com/app/ → Clienți). Vezi docs/WEB.md.
  // Worker-ul NU are adresă publică (workers_dev / preview_urls oprite): îl apelează doar Worker-ul
  // site-ului, prin legătura de serviciu „CRM”, după login-ul din site.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twopixeldev-crm",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "CRM_MODE": "web"
  }
  // Secrete (cu `npx wrangler secret put NUME`, niciodată în repo):
  //   DATABASE_URL      conexiunea Supabase (Transaction pooler, port 6543)
  //   CRM_PROXY_SECRET  același șir ca în Worker-ul site-ului (min. 32 de caractere)
  //   AUTH_SECRET       orice șir aleator (Auth.js îl cere la pornire, chiar dacă login-ul e al site-ului)
  // Opțional, mai rapid: Hyperdrive (conexiuni la Supabase ținute deschise de Cloudflare):
  //   "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<id din `npx wrangler hyperdrive create`>" }]
}
