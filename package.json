{
  "name": "twopixeldev-crm",
  "version": "0.3.8",
  "private": true,
  "description": "twopixeldev CRM: evidența unităților de cazare de pe litoral, de la prima găsire până devin clienți.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "import:cli": "tsx scripts/import-cli.ts",
    "postinstall": "prisma generate",
    "desktop:prepare": "node desktop/build.mjs",
    "desktop:start": "node desktop/build.mjs && electron desktop/app",
    "desktop:dist": "npm run build && node desktop/build.mjs && electron-builder --win --x64 --publish never",
    "web:build": "node scripts/web.mjs build",
    "web:preview": "node scripts/web.mjs build && node scripts/web.mjs preview",
    "web:deploy": "node scripts/web.mjs build && node scripts/web.mjs deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/archivo": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "@hookform/resolvers": "5.2.2",
    "@prisma/adapter-pg": "6.16.2",
    "@prisma/client": "6.16.2",
    "bcryptjs": "3.0.2",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "lucide-react": "1.60.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "papaparse": "5.5.3",
    "pg": "8.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.62.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@opennextjs/cloudflare": "1.20.12",
    "@types/node": "22.18.0",
    "@types/papaparse": "5.3.16",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.21",
    "electron": "44.9.0",
    "electron-builder": "26.17.0",
    "electron-updater": "6.8.11",
    "esbuild": "0.28.2",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.6",
    "prisma": "6.16.2",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "wrangler": "4.151.1"
  }
}
